# ========================================
# Docker Ignore File
# ========================================
# Exclude unnecessary files from Docker build context
# to speed up build times and reduce image size

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
*.whl

# Virtual environments
venv/
env/
ENV/
.venv/

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace

# Git
.git/
.gitignore
.gitattributes

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
azure-pipelines.yml
Jenkinsfile

# Documentation (exclude from production builds)
docs/
*.md
!README.md

# Test files
tests/
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Training outputs (should be mounted as volumes)
checkpoints/
training_outputs/
wandb/
*.pth
*.pt
*.onnx

# Data directories (should be mounted as volumes)
data/
datasets/
*.tif
*.png
*.jpg
*.jpeg

# Logs
*.log
logs/

# Environment files
.env
.env.*
!.env.example

# Development tools
.pre-commit-config.yaml
.flake8
.mypy_cache/
.bandit

# Makefiles and scripts (include only essential ones)
Makefile
*.sh
!scripts/*.sh

# Temporary files
tmp/
temp/
*.tmp
*.bak

# OS files
Thumbs.db
.DS_Store

# Jupyter notebooks
notebooks/
*.ipynb
.ipynb_checkpoints/

# Docker files (don't include in context)
Dockerfile
.dockerignore
docker-compose*.yml

# License and contribution files
LICENSE
CONTRIBUTING.md
CODE_OF_CONDUCT.md
CHANGELOG.md

# CI/CD summary
CICD_SUMMARY.txt
